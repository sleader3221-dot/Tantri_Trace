{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo \"TantriTrace static deploy: skipping dependency install\"",
  "buildCommand": "echo \"TantriTrace static deploy: using public/ as output\"",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/",
      "destination": "/tantritrace-ultimate/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/tantritrace-ultimate/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/tantritrace-ultimate/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
